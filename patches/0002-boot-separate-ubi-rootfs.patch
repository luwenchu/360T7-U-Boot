diff --git a/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c b/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
index 7ee1768..0314ea2 100644
--- a/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
+++ b/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
@@ -653,6 +653,27 @@ static int ubi_dual_boot(struct mtd_info *mtd)
 	return ret;
 }
 
+static int ubi_set_separate_rootfs_bootargs(void)
+{
+	int ret;
+
+	bootargs_reset();
+
+	ret = bootargs_set("ubi.mtd", PART_UBI_NAME);
+	if (ret)
+		return ret;
+
+	ret = bootargs_set("root", "ubi0:" PART_ROOTFS_NAME);
+	if (ret)
+		return ret;
+
+	ret = bootargs_set("rootfstype", "squashfs");
+	if (ret)
+		return ret;
+
+	return bootargs_set("rootwait", NULL);
+}
+
 static int boot_from_ubi(struct mtd_info *mtd)
 {
 	ulong data_load_addr = CONFIG_SYS_LOAD_ADDR;
@@ -662,7 +683,12 @@ static int boot_from_ubi(struct mtd_info *mtd)
 		return ret;
 
 	ret = read_ubi_volume(PART_KERNEL_NAME, (void *)data_load_addr, 0);
-	if (ret == ENODEV)
+	if (ret == ENODEV) {
 		ret = read_ubi_volume(PART_FIT_NAME, (void *)data_load_addr, 0);
+	} else if (!ret && ubi_find_volume(PART_ROOTFS_NAME)) {
+		ret = ubi_set_separate_rootfs_bootargs();
+		if (ret)
+			return ret;
+	}
 	if (ret)
 		return ret;
