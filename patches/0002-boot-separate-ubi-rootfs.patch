--- a/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
+++ b/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
@@ -1037,4 +1037,32 @@ static int ubi_dual_boot(struct mtd_info *mtd)
 }
 
+static int ubi_set_separate_rootfs_bootargs(void)
+{
+	const char *bootargs = env_get("bootargs");
+	const char *rootargs =
+		"ubi.mtd=" PART_UBI_NAME " root=ubi0:" PART_ROOTFS_NAME
+		" rootfstype=squashfs rootwait";
+	char *updated_bootargs;
+	size_t updated_len;
+	int ret;
+
+	if (bootargs && strstr(bootargs, "root=ubi0:" PART_ROOTFS_NAME))
+		return 0;
+
+	if (!bootargs || !*bootargs)
+		return env_set("bootargs", rootargs);
+
+	updated_len = strlen(bootargs) + strlen(rootargs) + 2;
+	updated_bootargs = malloc(updated_len);
+	if (!updated_bootargs)
+		return -ENOMEM;
+
+	snprintf(updated_bootargs, updated_len, "%s %s", bootargs, rootargs);
+	ret = env_set("bootargs", updated_bootargs);
+	free(updated_bootargs);
+
+	return ret;
+}
+
 static int boot_from_ubi(struct mtd_info *mtd)
 {
@@ -1047,6 +1075,11 @@ static int boot_from_ubi(struct mtd_info *mtd)
 
 	ret = read_ubi_volume(PART_KERNEL_NAME, (void *)data_load_addr, 0);
-	if (ret == ENODEV)
+	if (ret == ENODEV) {
 		ret = read_ubi_volume(PART_FIT_NAME, (void *)data_load_addr, 0);
+	} else if (!ret && ubi_find_volume(PART_ROOTFS_NAME)) {
+		ret = ubi_set_separate_rootfs_bootargs();
+		if (ret)
+			return ret;
+	}
 	if (ret)
 		return ret;
