diff --git a/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c b/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
--- a/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
+++ b/uboot-mtk-20230718-09eda825/board/mediatek/common/mtd_helper.c
@@ -679,6 +679,14 @@ static int write_ubi_fit_image(const void *data, size_t size,
 #endif /* CONFIG_ENV_IS_IN_UBI */
 	}
 
+	/*
+	 * A raw FIT is the only supported Web firmware format for this layout.
+	 * Remove legacy split-layout volumes so they cannot consume space or
+	 * take precedence during a later boot.
+	 */
+	remove_ubi_volume(PART_KERNEL_NAME);
+	remove_ubi_volume(PART_ROOTFS_NAME);
+
 	/* Remove this volume first in case of no enough PEBs */
 	remove_ubi_volume(PART_ROOTFS_DATA_NAME);
 
@@ -1073,13 +1081,15 @@ static int boot_from_ubi(struct mtd_info *mtd)
 	if (ret)
 		return ret;
 
-	ret = read_ubi_volume(PART_KERNEL_NAME, (void *)data_load_addr, 0);
+	ret = read_ubi_volume(PART_FIT_NAME, (void *)data_load_addr, 0);
 	if (ret == ENODEV) {
-		ret = read_ubi_volume(PART_FIT_NAME, (void *)data_load_addr, 0);
-	} else if (!ret && ubi_find_volume(PART_ROOTFS_NAME)) {
-		ret = ubi_set_separate_rootfs_bootargs();
-		if (ret)
-			return ret;
+		ret = read_ubi_volume(PART_KERNEL_NAME,
+				      (void *)data_load_addr, 0);
+		if (!ret && ubi_find_volume(PART_ROOTFS_NAME)) {
+			ret = ubi_set_separate_rootfs_bootargs();
+			if (ret)
+				return ret;
+		}
 	}
 	if (ret)
 		return ret;
